{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@zidney/app/*": ["./apps/*/src"],
      "@zidney/package/*": ["./packages/*/src"],
      "@zidney/ui/*": ["packages/ui-system/src/*"],
      "@zidney/domain-core": ["packages/domain-core/src/index.ts"],
      "@zidney/domain-core/*": ["packages/domain-core/src/*"],
      "@zidney/domain-core/scheduled-exam": ["packages/domain-core/src/scheduled-exam/index.ts"],
      "@zidney/domain-core/mmc-dashboard": ["packages/domain-core/mmc-dashboard/index.ts"],
      "@zidney/domain-core/mmc-dashboard/*": ["packages/domain-core/mmc-dashboard/*"],
      "@zidney/logger": ["packages/logger/src/index.ts"],
      "@zidney/logger/*": ["packages/logger/src/*"],
      "@zidney/types": ["packages/types/src/index.ts"],
      "@zidney/types/*": ["packages/types/src/*"],
      "@zidney/validation": ["packages/validation/src/index.ts"],
      "@zidney/validation/*": ["packages/validation/src/*"],
      "@zidney/redis-utils": ["packages/redis-utils/src/index.ts"],
      "@zidney/redis-utils/*": ["packages/redis-utils/src/*"],
      "@zidney/config": ["packages/config/src/index.ts"],
      "@zidney/config/*": ["packages/config/src/*"],
      "@zidney/api-client": ["packages/api-client/src/index.ts"],
      "@zidney/api-client/*": ["packages/api-client/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"],
  "types": ["vite/client"]
}
