{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/.cache/**",
    "**/.git/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.turbo/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "reports/**",
    "test-perf-output/**",
    "test-perf-output-2/**",
    "tmp/**"
  ]
}
