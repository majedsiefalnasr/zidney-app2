{
  "name": "@zidney/job-queue",
  "version": "1.0.0",
  "description": "Shared job queue types and interfaces for API and Worker",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./queue": {
      "types": "./src/job-queue.ts",
      "default": "./src/job-queue.ts"
    },
    "./types": {
      "types": "./src/job-schema.ts",
      "default": "./src/job-schema.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/job-queue.ts src/job-schema.ts --outdir dist --target=node",
    "test": "vitest"
  },
  "dependencies": {
    "@zidney/logger": "workspace:*",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/uuid": "9.0.0",
    "@zidney/types": "workspace:*",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  }
}
