{
  "version": 1,
  "hooks": {
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/dependency-license-checker/check-licenses.sh",
        "cwd": ".",
        "env": {
          "LICENSE_MODE": "${LICENSE_MODE:-warn}"
        },
        "timeout": 60
      }
    ]
  }
}
