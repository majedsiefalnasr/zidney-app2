{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": ".github/hooks/session-logger/log-session-start.sh",
        "cwd": ".",
        "timeout": 5,
        "env": {
          "LOG_LEVEL": "${LOG_LEVEL:-INFO}"
        }
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": ".github/hooks/session-logger/log-session-end.sh",
        "cwd": ".",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": ".github/hooks/session-logger/log-prompt.sh",
        "cwd": ".",
        "env": {
          "LOG_LEVEL": "${LOG_LEVEL:-INFO}",
          "CAPTURE_PROMPT_TEXT": "${CAPTURE_PROMPT_TEXT:-false}"
        },
        "timeout": 5
      }
    ]
  }
}
