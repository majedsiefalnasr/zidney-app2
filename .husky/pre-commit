#!/bin/sh
set -e

# ── Detect staged files once (shared across all steps) ──────────────────────
# FIX #4 — removed the no-op `tr '\n' '\n'`
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Nothing staged → skip quickly
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files — skipping hooks"
  exit 0
fi


# ── Staged-file quality gates (lint-staged + Biome) ───────────────────────
# FIX #1 — removed the manual formatter block that ran before lint-staged.
# Biome check --write (via lint-staged) handles both formatting AND linting in
# one pass. Running biome format --write first was redundant and created a race
# condition where the file could be staged in a different state than what
# lint-staged produced.

echo "Running lint-staged (Biome check --write on staged files)…"
bunx lint-staged

# ── Script UX Validator (staged + autofix) ───────────────────────────────
echo "Running Script UX validator (--staged --fix)…"
bun run validate:scripts:ux --staged --fix || {
  echo "❌ Script UX validation failed — commit blocked."
  echo "   Run: bun run validate:scripts:ux --staged --fix to auto-fix issues."
  exit 1
}


# ── TypeScript incremental validation (only if TS files changed) ────────────
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
  echo "Running TypeScript incremental validation…"
  # FIX #5 — added explicit error message so the developer knows why the
  # commit was blocked (previously set -e would just abort silently).
  # Using --skipLibCheck to stay fast; full tsc runs in pre-push and CI.
  bunx tsc --noEmit --skipLibCheck || {
    echo "❌ TypeScript validation failed — commit blocked."
    echo "   Run: bun typecheck to see all errors."
    exit 1
  }
fi


# ── GitNexus Context (staged-file context + validation) ─────────────────────
if [ -n "$STAGED_FILES" ]; then
  echo "Resolving GitNexus staged context…"
  bun run arch:context:changed -- --ci || {
    echo "❌ arch:context:changed failed — commit blocked."
    exit 1
  }
  echo "Validating GitNexus context artifact…"
  bun run arch:context:validate || {
    echo "❌ arch:context:validate failed — run 'bun run arch:context:build' to refresh artifact."
    exit 1
  }
fi


# ── Architecture Guard (skip if only docs/config changed) ───────────────────
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|vue)$' || true)

if [ -n "$CODE_FILES" ]; then
  echo "Running architecture governance checks…"
  # FIX #2 — removed --incremental flag (does not exist on ai-guard.ts).
  # FIX #3 — removed the STAGED_FILES reassignment. ai-guard.ts already
  # reads staged files via `git diff --cached` internally, so passing them
  # via env var was redundant AND it shadowed the STAGED_FILES variable used
  # by the brain validation check below.
  bun ai:guard
else
  echo "Skipping architecture checks (no code files changed)"
fi


# ── Validate Architecture Brain (if AI context files changed) ───────────────
# FIX #6 — validate-architecture-brain.ts confirmed present via package.json
# "arch:validate-brain" script. Hook is safe to keep.
BRAIN_FILES=$(echo "$STAGED_FILES" | grep -E 'docs/ai/context/ai-architecture-brain\.json' || true)

if [ -n "$BRAIN_FILES" ]; then
  echo "Validating architecture brain integrity…"
  set +e  # Temporarily disable exit-on-error to capture exit code
  bun arch:validate:brain
  BRAIN_EXIT=$?
  set -e  # Re-enable exit-on-error

  if [ "$BRAIN_EXIT" -eq 1 ]; then
    echo "❌ Architecture brain validation failed"
    echo "   The ai-architecture-brain.json has invalid or malformed dependency paths."
    echo "   This prevents AI Guard from validating correctly."
    echo "   Run: bun arch:audit to regenerate a valid brain."
    exit 1
  elif [ "$BRAIN_EXIT" -eq 2 ]; then
    echo "⚠️  Architecture brain has warnings but is valid"
    echo "   (Duplicate edges detected but no structural errors)"
  fi
fi


# ── Trivy security enforcement ─────────────────────────────────────────────
if ! command -v trivy >/dev/null 2>&1; then
  echo "❌ Trivy is required for pre-commit security enforcement."
  echo "   Install Trivy v0.59.1 before committing."
  echo "   Run: brew install trivy"
  exit 1
fi

echo "Running Trivy dependency scan…"
bun run infra:security:deps || {
  echo "❌ Trivy dependency scan failed — commit blocked."
  exit 1
}

echo "Running Trivy staged secret scan…"
bun run infra:security:secrets --staged || {
  echo "❌ Trivy secret scan failed — commit blocked."
  exit 1
}

# ── Policy Engine Gate (changed-files scope) ──────────────────────────────
echo "Running policy engine governance gate (changed-files scope)…"
bun run policy:check --changed || {
  echo "❌ Policy engine gate blocked the commit."
  echo "   Run: bun run policy:check --changed to see all violations."
  exit 1
}

# ── Final Summary ────────────────────────────────────────────────────────────
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit checks passed"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
