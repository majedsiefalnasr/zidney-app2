#!/bin/sh
set -e

# ── Detect staged files once (shared across steps) ─────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | tr '\n' '\n')

# Nothing staged → skip quickly
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files — skipping hooks"
  exit 0
fi


# ── Biome Formatter (staged files only, fast) ──────────────────────────────
# Formats only staged files to avoid touching the entire repository.
FORMAT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|vue|json)$' || true)

if [ -n "$FORMAT_FILES" ]; then
  echo "Formatting staged files with Biome…"
  echo "$FORMAT_FILES" | xargs -r bunx biome format --write
  echo "$FORMAT_FILES" | xargs -r git add
fi

# ── Staged-file quality gates (lint-staged + Biome lint) ───────────────────
# Runs Biome check --write on staged .ts/.tsx/.js/.jsx/.mjs/.vue/.json files.
# Commit is blocked if any lint error remains after auto-fix.
bunx lint-staged

# ── Optional TypeScript quick check (only if TS files changed) ─────────────
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
  echo "Running TypeScript incremental validation…"
  bunx tsc --noEmit --skipLibCheck
fi

# ── Architecture + Infrastructure Guards (skip if only docs/config changed) ──
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|vue)$' || true)

if [ -n "$CODE_FILES" ]; then
  echo "Running architecture governance checks…"

  # Run guards in parallel for faster commits
  bun scripts/ai-guard.ts &
  PID_AI=$!

  bun scripts/infra-audit.ts --quick &
  PID_INFRA=$!

  wait $PID_AI
  wait $PID_INFRA
else
  echo "Skipping architecture checks (no code files changed)"
fi

# ── Validate Architecture Brain (if AI context files changed) ─────────────────
BRAIN_FILES=$(echo "$STAGED_FILES" | grep -E 'docs/ai/context/ai-architecture-brain\.json' || true)

if [ -n "$BRAIN_FILES" ]; then
  echo "Validating architecture brain integrity…"
  set +e  # Temporarily disable exit-on-error to check exit code
  bun scripts/validate-architecture-brain.ts
  BRAIN_EXIT=$?
  set -e  # Re-enable exit-on-error
  
  if [ "$BRAIN_EXIT" -eq 1 ]; then
    echo "❌ Architecture brain validation failed"
    echo "   The ai-architecture-brain.json has invalid or malformed dependency paths."
    echo "   This prevents AI Guard from validating correctly."
    echo "   Run: bun scripts/infra-audit.ts to regenerate a valid brain."
    exit 1
  elif [ "$BRAIN_EXIT" -eq 2 ]; then
    echo "⚠️ Architecture brain has warnings but is valid"
    echo "   (Duplicate edges detected but no structural errors)"
  fi
fi

echo "✔ Pre-commit checks passed"
