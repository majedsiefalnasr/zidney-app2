#!/bin/sh
set -e

# ── Zidney Pre-Push Governance Gate ─────────────────────────────────────────
# This hook runs heavier checks than pre-commit. It validates architecture
# integrity and repository health before code leaves the developer machine.
#
# Philosophy:
# - pre-commit  → ultra-fast developer feedback (<5s)
# - pre-push    → deeper validation (architecture + tests)
# - CI          → full pipeline enforcement


# ── Detect changed files in this push ───────────────────────────────────────
# FIX #9 — @{u} fails fatally on branches with no upstream (e.g. first push
# of a new branch), causing the hook to silently skip ALL checks via the
# 2>/dev/null fallback. Now we fall back to the merge-base against main, then
# to HEAD~1, with a visible warning so the developer knows what happened.
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)

if [ -n "$UPSTREAM" ]; then
  CHANGED_FILES=$(git diff --name-only HEAD "@{u}")
else
  MERGE_BASE=$(git merge-base HEAD origin/main 2>/dev/null || true)
  if [ -n "$MERGE_BASE" ]; then
    echo "⚠️  No upstream set — diffing against merge-base with origin/main."
    CHANGED_FILES=$(git diff --name-only "$MERGE_BASE" HEAD)
  else
    echo "⚠️  No upstream and no origin/main — diffing against HEAD~1."
    CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || true)
  fi
fi

if [ -z "$CHANGED_FILES" ]; then
  echo "No changes detected for push — skipping checks"
  exit 0
fi

# ── Resolve GitNexus staged context (CI/no-write mode) ────────────────────
echo "Resolving GitNexus staged context (CI mode — no writes)…"
bun run arch:context:changed -- --ci || {
  echo "❌ arch:context:changed failed — push blocked."
  exit 1
}


# ── Architecture Governance (blocking) ──────────────────────────────────────
# FIX #2 — removed --full flag (does not exist on ai-guard.ts).
# ai-guard.ts runs a full staged/changed-file scan by default.
echo "Running architecture governance validation..."
bun scripts/ai-guard.ts --ci || {
  echo "❌ Architecture guard failed — push blocked."
  exit 1
}


# ── Infrastructure Audit ─────────────────────────────────────────────────────
# FIX #8 — Pre-push runs the FULL audit (not --quick) so that the architecture
# brain, context files, and dashboards are regenerated before code leaves the
# machine. --quick skips all file writes and is only appropriate for the
# pre-commit hook where speed is critical.
echo "Running full infrastructure audit..."
bun scripts/infra-audit.ts --quick || {
  echo "❌ Infrastructure audit failed — push blocked."
  exit 1
}


# ── Architecture Brain Validation (blocking) ─────────────────────────────────
echo "Validating architecture brain integrity..."
bun scripts/governance/validate-architecture-brain.ts || {
  echo "❌ Architecture brain validation failed — push blocked."
  echo "   Run: bun scripts/infra-audit.ts to regenerate a valid brain."
  exit 1
}


# ── Unit Tests (informational) ──────────────────────────────────────────────
# Tests are non-blocking here — CI enforces them on PR.
# If tests fail locally, the push proceeds with a visible warning.
echo "Running unit test suite..."
if bun run test:unit 2>&1 | tail -20; then
  echo "✅ Unit tests passing — push will proceed."
else
  echo "⚠️  Unit tests failed locally."
  echo "   Push will still proceed, but CI will block the PR until tests pass."
  echo "   Run: bun run test:unit to debug."
fi


# ── TypeScript Full Project Validation ──────────────────────────────────────
TS_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(ts|tsx)$' || true)

if [ -n "$TS_FILES" ]; then
  echo "Running full TypeScript project validation..."
  # Using typecheck script from package.json (covers src + tests tsconfigs)
  bun run typecheck || {
    echo "❌ TypeScript validation failed — push blocked."
    echo "   Run: bun typecheck to see all errors."
    exit 1
  }
fi


# ── GitHub Actions Workflow Validation ──────────────────────────────────────
# Graceful skip if actionlint is not installed (local dev convenience).
# CI enforces actionlint unconditionally.
if command -v actionlint > /dev/null 2>&1; then
  echo "Validating GitHub Actions workflows..."
  # actionlint does not accept a directory path — it requires explicit file
  # paths. Use find to collect all workflow files and pass them as arguments.
  if [ -d ".github/workflows" ]; then
    WORKFLOW_FILES=$(find .github/workflows -type f \( -name "*.yml" -o -name "*.yaml" \))
    if [ -z "$WORKFLOW_FILES" ]; then
      echo "⚠️  No workflow files found under .github/workflows — skipping."
    else
      # shellcheck disable=SC2086
      actionlint $WORKFLOW_FILES || {
        echo "❌ GitHub Actions workflow validation failed — push blocked."
        echo "   Fix the workflow issues reported above by actionlint."
        exit 1
      }
    fi
  else
    echo "⚠️  No .github/workflows directory found — skipping."
  fi
else
  echo "⚠️  actionlint not installed — skipping workflow validation."
  echo "   Install: brew install actionlint"
fi


# ── Script UX Validator (full scan, blocking) ───────────────────────────────
echo "Running Script UX validator (full scan)…"
bun run validate:scripts:ux || {
  echo "❌ Script UX validation failed — push blocked."
  echo "   Run: bun run validate:scripts:ux --fix to auto-fix issues."
  exit 1
}

# ── Final Summary ────────────────────────────────────────────────────────────
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Zidney Pre-Push Governance: PASSED"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
