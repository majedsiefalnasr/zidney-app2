#!/bin/sh

# ── Pre-Push Quality Gate ───────────────────────────────────────────────────
# Informational checks before push (non-blocking).
# Development workflow: developers can push even if tests are failing locally,
# but should investigate and fix failures.
# CI will enforce full test suite on PR.
#
# NOTE: bun run lint and bun run typecheck are deferred until the pre-existing
# baseline errors (12 lint errors + 2 TS2306 errors on develop, pre-infra-governance)
# are resolved in a subsequent stage. lint-staged (pre-commit) already gates
# per-file ESLint on every commit. Re-enable full-repo lint/typecheck here once
# the baseline in apps/api, apps/mmc, apps/frontoffice is clean.

# Full unit test suite (informational — does not block push)
echo "Running unit test suite..."
if bun run test:unit 2>&1 | tail -20; then
  echo "✅ Unit tests passing — push will proceed."
else
  echo "⚠️  Unit tests failed locally. See above for details."
  echo "   This is informational only. Push will proceed."
  echo "   CI will enforce full test suite on PR."
fi
