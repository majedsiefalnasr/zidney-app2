{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": [
        "./apps/mmc/src/*",
        "./apps/backoffice/src/*",
        "./apps/frontoffice/src/*"
      ]
    }
  },
  "include": [
    "apps/*/src/**/*",
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules/**",
    "tests/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "apps/*/tests/**/*"
  ]
}
