{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/*/src/**/*",
    "packages/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules/**",
    "tests/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "apps/*/tests/**/*"
  ]
}
