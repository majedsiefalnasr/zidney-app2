{
  "name": "zidney",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun typecheck:src && bun typecheck:tests",
    "typecheck:src": "tsc --noEmit",
    "typecheck:tests": "bun typecheck:src -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "bun run format:biome && bun run format:prettier",
    "format:biome": "biome format --write .",
    "format:prettier": "prettier --write '**/*.{md,yaml,yml}'",
    "format:check": "bun run format:check:biome && bun run format:check:prettier",
    "format:check:biome": "biome format .",
    "format:check:prettier": "prettier --check '**/*.{md,yaml,yml}'",
    "validate:workflows": "find .github/workflows -type f \\( -name '*.yml' -o -name '*.yaml' \\) | xargs actionlint",
    "validate:types": "bun typecheck && bun arch:type-safety-guard --json",
    "validate:tsconfig": "bash scripts/validate/check-tsconfig-strict.sh",
    "validate:ai-context-fresh": "bun run scripts/validate/ai-context-fresh.ts",
    "validate:ai-context-schemas": "bun run scripts/validate/ai-context-schemas.ts",
    "validate:scripts:runtime": "bun run scripts/validate/runtime-scripts.ts",
    "validate:scripts:broken": "bun run scripts/validate/detect-broken-scripts.ts",
    "validate:scripts:naming": "bun scripts/validate/script-naming.ts",
    "validate:scripts:usage": "bun scripts/validate/script-usage.ts",
    "validate:scripts:infrastructure": "bun scripts/validate/script-infrastructure.ts",
    "validate:scripts:registry": "bun scripts/validate/diff-script-registry.ts",
    "validate:scripts:ux": "bun scripts/validate/validate-scripts-ux.ts",
    "validate:scan:packages": "bun scripts/validate/scan-package-scripts.ts",
    "arch:check:store-cycles": "bun scripts/check-store-cycles.ts",
    "arch:add-module": "bun scripts/architecture/add-module.ts",
    "arch:generate": "bun scripts/architecture/generate-architecture-map.ts",
    "arch:audit": "bun scripts/infra-audit.ts",
    "arch:gitnexus:context": "bun scripts/gitnexus-context.ts",
    "arch:gitnexus:validate": "bun scripts/validate/validate-gitnexus.ts",
    "arch:refresh": "bun arch:audit && bun arch:gitnexus:context",
    "arch:context:build": "bun scripts/context/build.ts",
    "arch:context:changed": "bun scripts/context/changed.ts",
    "arch:context:impact": "bun scripts/context/impact.ts",
    "arch:context:validate": "bun scripts/context/validate.ts",
    "arch:fix": "bun arch:audit --fix-map",
    "arch:guard": "bun scripts/architecture-guard/architecture-guard.ts",
    "arch:guard:ci": "bun scripts/architecture-guard/architecture-guard.ts --ci",
    "arch:guard:changed": "bun scripts/architecture-guard/architecture-guard.ts --changed",
    "arch:diff": "bun scripts/architecture-diff.ts",
    "arch:health": "bun scripts/architecture-health/architecture-health.ts",
    "arch:health:ci": "bun scripts/architecture-health/architecture-health.ts --ci",
    "arch:validate:brain": "bun scripts/governance/validate-architecture-brain.ts",
    "arch:visualize": "bun scripts/architecture/visualize.ts",
    "arch:type-safety-guard": "bun scripts/type-safety-guard.ts",
    "arch:audit:check": "bun run arch:audit --check",
    "test": "vitest run",
    "test:unit": "vitest run --project mmc --project backoffice --project frontoffice --project api-client --project domain-core --project logger --project config --project redis-utils --project types --project ui-system --project validation",
    "test:unit:debug": "vitest run --reporter verbose --project mmc --project backoffice --project frontoffice --project api-client --project domain-core --project logger --project config --project redis-utils --project types --project ui-system --project validation",
    "test:unit:boundaries": "vitest run tests/static/module-boundaries.test.ts tests/unit/infra-audit/infra-audit-boundaries.test.ts tests/unit/ai-guard/ai-guard-boundaries.test.ts",
    "test:integration": "vitest run --dir tests/integration --fileParallelism=false",
    "test:performance": "vitest run --dir tests/performance",
    "test:static": "vitest run --dir tests/static",
    "test:coverage": "vitest run --coverage",
    "test:e2e:mmc": "bunx playwright test --config apps/mmc/playwright.config.ts",
    "test:e2e:backoffice": "bunx playwright test --config apps/backoffice/playwright.config.ts",
    "test:e2e:frontoffice": "bunx playwright test --config apps/frontoffice/playwright.config.ts",
    "test:e2e": "bun run test:e2e:mmc && bun run test:e2e:backoffice && bun run test:e2e:frontoffice",
    "build": "bun run --workspaces build",
    "build:api": "bun --cwd apps/api build",
    "build:packages": "bash -lc 'for d in packages/*; do if [ -f \"$d/package.json\" ]; then (cd \"$d\" && echo \"Building $d\" && bun run build); fi; done'",
    "dev": "bun run dev:all",
    "dev:infra": "docker compose up -d",
    "dev:api": "bun --cwd apps/api dev",
    "dev:worker": "bun --cwd apps/worker dev",
    "dev:mmc": "bun --cwd apps/mmc dev",
    "dev:backoffice": "bun --cwd apps/backoffice dev",
    "dev:frontoffice": "bun --cwd apps/frontoffice dev",
    "dev:all": "concurrently \"bun run dev:api\" \"bun run dev:worker\" \"bun run dev:mmc\" \"bun run dev:backoffice\" \"bun run dev:frontoffice\"",
    "dev:demo:logger": "bun scripts/dev/demo-logger-features.ts",
    "dev:hygiene:report": "bun scripts/dev/hygiene-report-generator.ts",
    "dev:generate:script-docs": "bun scripts/generate/script-docs.ts",
    "dev:seed:dashboard-test-data": "bun run scripts/seed/dashboard-test-data.ts",
    "dev:refactor:scripts": "bun scripts/dev/refactor-scripts.ts",
    "ai:runtime:status": "bun scripts/ai-runtime/runtime-status.ts",
    "ai:run": "bun scripts/ai-engine/run-task.ts",
    "ai:plan": "bun scripts/ai-engine/plan-task.ts",
    "ai:validate": "bun scripts/ai-engine/validate-execution.ts",
    "ai:validate:prompts": "bun scripts/prompt-qa.ts",
    "ai:context:generate": "bun scripts/generate-ai-context.ts",
    "ai:context:refresh": "bun scripts/generate-ai-context.ts --force",
    "ai:context:validate": "bun run validate:ai-context-fresh && bun run validate:ai-context-schemas",
    "ai:guard": "bun run scripts/ai-guard.ts",
    "repo:doctor": "bun scripts/dev/repo-doctor.ts",
    "repo:fix": "bun scripts/dev/repo-fix.ts",
    "repo:onboard": "bun scripts/dev/repo-onboard.ts",
    "repo:status": "bun scripts/dev/repo-status.ts",
    "db:console": "bun run scripts/db/console.ts",
    "db:migrate": "bun run scripts/db/migrate.ts",
    "db:status:pool": "bun run scripts/db/pool-status.ts",
    "db:validate:licenses": "bun run scripts/db/validate-licenses.ts",
    "infra:cache:clean": "bun run scripts/maintenance/cache-clean.ts",
    "infra:security": "bun scripts/security/scan.ts",
    "infra:security:deps": "bun scripts/security/scan-deps.ts",
    "infra:security:secrets": "bun scripts/security/scan-secrets.ts",
    "infra:security:config": "bun scripts/security/scan-config.ts",
    "infra:security:ci": "bun scripts/security/scan-ci.ts",
    "governance:gate": "bun scripts/governance/gate.ts",
    "governance:gate:ci": "bun scripts/governance/gate-ci.ts",
    "governance:gate:changed": "bun run arch:context:changed && bun run arch:guard:changed",
    "governance:report": "bun scripts/governance/report.ts",
    "ci:smoke:staging": "bash scripts/ci/run-staging-smoke-tests.sh",
    "ci:local": "act --pull=false",
    "ci:local:full": "act --pull --reuse=false",
    "ci:local:workflow": "act -W .github/workflows",
    "ci:local:job": "act -j",
    "ci:local:list": "act -l",
    "ci:local:dry": "actionlint .github/workflows/*.yml",
    "ci:run-local": "bun scripts/run-local-ci.ts",
    "ci:test": "vitest run --reporter=verbose",
    "test:tenant": "vitest run --dir tests/tenant || true",
    "test:migrations": "vitest run --dir tests/migrations || true",
    "dev:stale-test": "echo 'dev:stale-test placeholder'",
    "validate:runtime:scripts": "bun run scripts/validate/runtime-scripts.ts",
    "dev:demo-logger-features": "bun run dev:demo:logger",
    "repo:references": "echo 'references placeholder'",
    "repo:script": "echo 'script placeholder'",
    "policy:check": "bun scripts/policy-engine/cli.ts",
    "policy:check:full": "bun scripts/policy-engine/cli.ts --full",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.2",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "concurrently": "^8.2.0",
    "gitnexus": "^1.4.6",
    "hono": "4.12.9",
    "husky": "^9.0.0",
    "ioredis": "^5.3.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.0.0",
    "madge": "^8.0.0",
    "pg": "^8.18.0",
    "pinia": "2.2.6",
    "prettier": "^3",
    "typescript": "latest",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "^1.0.0",
    "vue-router": "4.6.4",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "hono": "4.12.9"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "dependencies": {
    "@types/bun": "1.3.11",
    "string-width": "^8.2.0"
  }
}
