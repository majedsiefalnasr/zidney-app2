{
  "chat.promptFilesRecommendations": {
    "speckit.constitution": true,
    "speckit.specify": true,
    "speckit.plan": true,
    "speckit.tasks": true,
    "speckit.implement": true
  },
  "chat.tools.terminal.autoApprove": {
    ".specify/scripts/bash/": true,
    ".specify/scripts/powershell/": true,
    "mkdir": true,
    "/^bash \\.specify\\/scripts\\/bash\\/check-prerequisites\\.sh(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "bun": true,
    "/^bash \\.specify\\/scripts\\/bash\\/setup-plan\\.sh(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^bash \\.specify\\/scripts\\/bash\\/update-agent-context\\.sh(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^\\.specify\\/scripts\\/bash\\/check-prerequisites\\.sh(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^\\.specify\\/scripts\\/bash\\/setup-plan\\.sh(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^\\.specify\\/scripts\\/bash\\/update-agent-context\\.sh(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "npx eslint": true,
    "npx tsc": true,
    "act": true,
    "gh": true,
    "git stash": true,
    "git checkout": true,
    "bunx": true,
  },
  "css.lint.unknownAtRules": "ignore",
  "css.customData": [
    ".vscode/css_custom_data.json"
  ],
  "cSpell.words": [
    "lucide",
    "notif",
    "plpgsql",
    "shadcn",
    "TIMESTAMPTZ",
    "uuidv",
    "Zidney"
  ],
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[vue]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "editor.formatOnSave": true
}
