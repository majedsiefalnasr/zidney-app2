{
  "dashboard": {
    "title": "Zidney Tenant Schema Provisioning",
    "description": "Real-time monitoring of tenant database schema initialization and provisioning tasks",
    "tags": ["zidney", "schema", "provisioning", "tenant", "production"],
    "timezone": "utc",
    "panels": [
      {
        "id": 1,
        "title": "Active Provisioning Tasks",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (status) (increase(provisioning_tasks_total{status=~\"PENDING|IN_PROGRESS\"}[5m]))",
            "legendFormat": "{{status}}"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Tasks"
          }
        ]
      },
      {
        "id": 2,
        "title": "Task Success Rate (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "100 * (increase(provisioning_tasks_total{status=\"COMPLETED\"}[24h]) / increase(provisioning_tasks_total[24h]))",
            "legendFormat": "Success Rate"
          }
        ],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "red",
              "value": 0
            },
            {
              "color": "yellow",
              "value": 95
            },
            {
              "color": "green",
              "value": 99
            }
          ]
        }
      },
      {
        "id": 3,
        "title": "Task Duration (p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, provisioning_task_duration_seconds_bucket)"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          }
        ]
      },
      {
        "id": 4,
        "title": "Failed Tasks (1h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(provisioning_tasks_total{status=\"FAILED\"}[1h])"
          }
        ],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": 0
            },
            {
              "color": "yellow",
              "value": 1
            },
            {
              "color": "red",
              "value": 5
            }
          ]
        }
      },
      {
        "id": 5,
        "title": "Dead-lettered Tasks",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(provisioning_tasks_total{status=\"DLQ\"})"
          }
        ],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": 0
            },
            {
              "color": "red",
              "value": 1
            }
          ]
        }
      },
      {
        "id": 6,
        "title": "Schema Version Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (version) (up{job=\"tenant-schema\"})"
          }
        ]
      },
      {
        "id": 7,
        "title": "Database Connection Pool Utilization",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_activity_count{state=\"active\", job=\"tenant-db\"} / on() group_left() pg_settings_max_connections"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "min": 0,
            "max": 1
          }
        ]
      },
      {
        "id": 8,
        "title": "Stuck Provisioning Tasks Alert",
        "type": "stat",
        "targets": [
          {
            "expr": "count(provisioning_tasks_stuck_duration_seconds > 3600)"
          }
        ],
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": 0
            },
            {
              "color": "red",
              "value": 1
            }
          ]
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "workspace_id",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(provisioning_tasks_total, workspace_id)",
          "multi": true,
          "includeAll": true
        },
        {
          "name": "status",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(provisioning_tasks_total, status)",
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  },
  "metadata": {
    "file": "docs/monitoring/dashboard-schema-provisioning.json",
    "created": "2026-02-16",
    "version": "1.0.0",
    "status": "PRODUCTION",
    "critical": true,
    "deployment": "terraform"
  }
}
