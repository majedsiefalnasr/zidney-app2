# Zidney Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration
# PostgreSQL connection for master database
DATABASE_URL=postgresql://user:password@localhost:5432/zidney_master

# Redis Configuration
# Redis connection for caching and queues
REDIS_URL=redis://localhost:6379

# Development Settings
NODE_ENV=development
LOG_LEVEL=info

# Application Ports (for local development)
API_PORT=3000
MMC_PORT=3001
BACKOFFICE_PORT=3002
FRONTOFFICE_PORT=3003

# Security (use strong secrets in production)
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# External Services (if applicable)
# Add any external API keys or service URLs here

# Docker Settings
COMPOSE_PROJECT_NAME=zidney-dev
