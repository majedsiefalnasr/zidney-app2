{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "@typescript-eslint/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "import"
  ],
  "rules": {
    "no-console": "error",
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          {
            "target": "apps/**",
            "from": "apps/**",
            "message": "Apps cannot import from other apps"
          },
          {
            "target": "packages/**",
            "from": "apps/**",
            "message": "Packages cannot import from apps"
          }
        ]
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true
      }
    }
  }
}
