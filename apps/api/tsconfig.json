{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*",
    "src/**/__tests__/**/*",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
