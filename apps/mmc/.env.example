# ─── MMC Environment Variables ─────────────────────────────────────────────
#
# Copy this file to .env and fill in the values.
#
# MIGRATION NOTE: Application environment is now read from VITE_APP_ENV
# instead of Vite's MODE. If you were previously relying on MODE for
# environment detection, set VITE_APP_ENV explicitly.
# ───────────────────────────────────────────────────────────────────────────

# Required: API server base URL
VITE_API_BASE_URL=http://localhost:3000

# Required: Application environment (development | staging | production)
VITE_APP_ENV=development

# Required: Application name identifier
VITE_APP_NAME=mmc

# Optional: Enable debug behaviors (true | false)
VITE_DEBUG_MODE=false

# Optional: Feature flag — show debug panel UI (true | false)
VITE_ENABLE_DEBUG_PANEL=false
