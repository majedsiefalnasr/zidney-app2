# Provisioning Worker Configuration
# Stage: STAGE_12_PROVISIONING_TRIGGER
# 
# This file defines environment variables for the provisioning worker service.
# All values are examples; update for your deployment environment.

# === Redis Configuration ===
# Location of Redis instance (used for job queue and distributed locks)
REDIS_URL=redis://localhost:6379

# Connection pool size for Redis
REDIS_POOL_SIZE=10

# Redis password (if required)
REDIS_PASSWORD=

# === Master Database Configuration ===
# PostgreSQL connection string for master database
# Format: postgresql://user:password@host:port/database
MASTER_DB_URL=postgresql://postgres:password@localhost:5432/zidney_master

# Master database pool size
MASTER_DB_POOL_SIZE=20

# Query timeout (milliseconds)
DB_QUERY_TIMEOUT_MS=30000

# === Tenant Database Configuration ===
# PostgreSQL hostname for creating tenant databases
PG_HOST=localhost
PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=password

# Admin user for database creation (must have CREATEDB privilege)
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=password

# === Queue Configuration ===
# Main provisioning job queue name
PROVISIONING_QUEUE_NAME=provisioning:jobs

# Consumer group name (for Redis Streams)
PROVISIONING_CONSUMER_GROUP=provisioning-worker

# Consumer name (usually generated with WORKER_ID)
PROVISIONING_CONSUMER_NAME=provisioning-consumer

# Maximum concurrent provisioning jobs
PROVISIONING_MAX_CONCURRENT=10

# Visibility timeout for jobs (seconds)
PROVISIONING_VISIBILITY_TIMEOUT=300

# Distributed lock TTL (seconds)
PROVISIONING_LOCK_TTL=30

# Metrics reporting interval (seconds)
PROVISIONING_METRICS_INTERVAL=60

# Dead letter queue retention (hours)
PROVISIONING_DLQ_RETENTION_HOURS=504

# === Logging Configuration ===
# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Log file location (default: stdout)
LOG_FILE=/var/log/provisioning-worker.log

# Application version (included in log metadata)
APP_VERSION=1.0.0

# === Worker Configuration ===
# Unique worker ID (auto-generated if not provided)
WORKER_ID=provisioning-worker-1

# Graceful shutdown timeout (milliseconds)
SHUTDOWN_TIMEOUT_MS=30000

# === Feature Flags ===
# Enable experimental features
FEATURE_ENABLE_DIVISIONS=true

# Enable observability metrics
FEATURE_ENABLE_METRICS=true

# === Service Configuration ===
# MMC service hostname (for license validation)
MMC_SERVICE_URL=http://localhost:3000

# Service name identifier
SERVICE_NAME=provisioning-worker

# Service version
SERVICE_VERSION=1.0.0

# === Security ===
# API authentication token for MMC
MMC_SERVICE_TOKEN=dev-service-token-replace-in-production

# Enable HTTPS for inter-service communication
ENABLE_HTTPS=false

# Path to CA certificate (if needed)
CA_CERT_PATH=

# === Provisioning Configuration ===
# Default schema version applied to new workspaces
DEFAULT_SCHEMA_VERSION=1.0.0

# Default product version
DEFAULT_PRODUCT_VERSION=1.0.0

# Retry configuration
PROVISION_MAX_RETRIES=3
PROVISION_INITIAL_BACKOFF_MS=1000
PROVISION_MAX_BACKOFF_MS=60000

# Tenant database template (if using PostgreSQL templates)
TEMPLATE_DATABASE=template1

# Locale for new tenant databases
LOCALE_FOR_TENANT_DATABASE=en_US.UTF-8

# === Monitoring & Observability ===
# Prometheus metrics port
METRICS_PORT=9090

# Health check endpoint port
HEALTH_CHECK_PORT=8080

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# === Development Mode ===
# Enable development logging/debugging
DEBUG=false

# Simulate provisioning (for testing)
SIMULATE_PROVISIONING=false

# Skip actual database creation (test mode)
DRY_RUN=false
