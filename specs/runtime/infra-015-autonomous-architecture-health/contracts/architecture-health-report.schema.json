{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zidney.local/schemas/architecture-health-report.schema.json",
  "title": "ArchitectureHealthReport",
  "type": "object",
  "required": [
    "schema_version",
    "assessment_id",
    "generated_at",
    "overall",
    "threshold_policy",
    "signals",
    "findings",
    "intelligence_snapshot",
    "source_runs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall": {
      "type": "object",
      "required": ["score", "health_state", "threshold", "verdict"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "health_state": {
          "type": "string",
          "enum": ["EXCELLENT", "HEALTHY", "WARNING", "CRITICAL"]
        },
        "threshold": {
          "type": "object",
          "required": ["policy_id", "minimum_passing_score"],
          "properties": {
            "policy_id": {
              "type": "string",
              "minLength": 1
            },
            "minimum_passing_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "verdict": {
          "type": "string",
          "enum": ["PASS", "BLOCKED"]
        }
      },
      "additionalProperties": false
    },
    "threshold_policy": {
      "$ref": "#/$defs/threshold_policy"
    },
    "signals": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/dependency_integrity_signal"
        },
        {
          "$ref": "#/$defs/layer_integrity_signal"
        },
        {
          "$ref": "#/$defs/circular_dependency_risk_signal"
        },
        {
          "$ref": "#/$defs/type_safety_governance_signal"
        },
        {
          "$ref": "#/$defs/architecture_drift_signal"
        },
        {
          "$ref": "#/$defs/intelligence_synchronization_signal"
        }
      ],
      "items": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "signal_ids",
          "classification",
          "severity",
          "impacted_surface",
          "message",
          "remediation",
          "source_tools"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "signal_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "dependency_integrity",
                "layer_integrity",
                "circular_dependency_risk",
                "type_safety_governance",
                "architecture_drift",
                "intelligence_synchronization"
              ]
            }
          },
          "classification": {
            "type": "string",
            "enum": ["direct_rule_violation", "drift", "synchronization"]
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "impacted_surface": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "source_tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "intelligence_snapshot": {
      "$ref": "#/$defs/intelligence_snapshot"
    },
    "source_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "command", "started_at", "finished_at", "exit_code", "output_format"],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "enrichment_mode": {
            "type": "string",
            "enum": ["none", "gitnexus_query", "gitnexus_impact"]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "exit_code": {
            "type": "integer",
            "minimum": 0
          },
          "output_format": {
            "type": "string",
            "enum": ["json", "markdown", "text"]
          },
          "consumed_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "signal_base": {
      "type": "object",
      "required": ["signal_id", "weight", "status", "score_delta", "finding_count", "sources"],
      "properties": {
        "signal_id": {
          "type": "string"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "WARN", "FAIL"]
        },
        "score_delta": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "threshold_policy": {
      "type": "object",
      "required": [
        "policy_id",
        "minimum_passing_score",
        "weights",
        "hard_fail_conditions",
        "status_mapping"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "minimum_passing_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "weights": {
          "type": "object",
          "required": [
            "dependency_integrity",
            "layer_integrity",
            "circular_dependency_risk",
            "type_safety_governance",
            "architecture_drift",
            "intelligence_synchronization"
          ],
          "properties": {
            "dependency_integrity": { "type": "number", "minimum": 0, "maximum": 100 },
            "layer_integrity": { "type": "number", "minimum": 0, "maximum": 100 },
            "circular_dependency_risk": { "type": "number", "minimum": 0, "maximum": 100 },
            "type_safety_governance": { "type": "number", "minimum": 0, "maximum": 100 },
            "architecture_drift": { "type": "number", "minimum": 0, "maximum": 100 },
            "intelligence_synchronization": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "hard_fail_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status_mapping": {
          "type": "object",
          "required": ["excellent", "healthy", "warning", "critical"],
          "properties": {
            "excellent": { "$ref": "#/$defs/score_range" },
            "healthy": { "$ref": "#/$defs/score_range" },
            "warning": { "$ref": "#/$defs/score_range" },
            "critical": { "$ref": "#/$defs/score_range" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "score_range": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "intelligence_snapshot": {
      "type": "object",
      "required": ["snapshot_id", "artifacts", "validation_status"],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intelligence_artifact_status"
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "validation_status": {
          "type": "string",
          "enum": ["CURRENT", "STALE", "MISSING", "INVALID"]
        },
        "validation_notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "intelligence_artifact_status": {
      "type": "object",
      "required": ["artifact_name", "path", "required", "exists", "status"],
      "properties": {
        "artifact_name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "exists": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["CURRENT", "STALE", "MISSING", "INVALID"]
        },
        "last_modified_at": {
          "type": "string",
          "format": "date-time"
        },
        "validator": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dependency_integrity_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/signal_base"
        },
        {
          "properties": {
            "signal_id": {
              "const": "dependency_integrity"
            }
          }
        }
      ]
    },
    "layer_integrity_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/signal_base"
        },
        {
          "properties": {
            "signal_id": {
              "const": "layer_integrity"
            }
          }
        }
      ]
    },
    "circular_dependency_risk_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/signal_base"
        },
        {
          "properties": {
            "signal_id": {
              "const": "circular_dependency_risk"
            }
          }
        }
      ]
    },
    "type_safety_governance_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/signal_base"
        },
        {
          "properties": {
            "signal_id": {
              "const": "type_safety_governance"
            }
          }
        }
      ]
    },
    "architecture_drift_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/signal_base"
        },
        {
          "properties": {
            "signal_id": {
              "const": "architecture_drift"
            }
          }
        }
      ]
    },
    "intelligence_synchronization_signal": {
      "allOf": [
        {
          "$ref": "#/$defs/signal_base"
        },
        {
          "properties": {
            "signal_id": {
              "const": "intelligence_synchronization"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
